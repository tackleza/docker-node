index 0000000000000000000000000000000000000000..ffdb1038184f50887ddf8c50e547ea40233869cb
--- /dev/null
+++ b/packages/frontend/@n8n/design-system/src/components/N8nMarkdown/Markdown.rendering.test.ts
@@ -0,0 +1,18 @@
+import { render } from '@testing-library/vue';
+import { performance } from 'node:perf_hooks';
+
+import N8nMarkdown from './Markdown.vue';
+import { n8nHtml } from '../../directives';
+
+describe('N8nMarkdown rendering', () => {
+	it('renders long mixed quote text within a bounded interval', () => {
+		const content = '"a '.repeat(64_000) + "b' ".repeat(64_000);
+		const start = performance.now();
+		const wrapper = render(N8nMarkdown, {
+			global: { directives: { n8nHtml } },
+			props: { content },
+		});
+		expect(wrapper.container.textContent?.length).toBeGreaterThan(300_000);
+		expect(performance.now() - start).toBeLessThan(5_000);
+	}, 15_000);
+});
diff --git a/packages/frontend/editor-ui/src/app/__tests__/markdown-rendering.test.ts b/packages/frontend/editor-ui/src/app/__tests__/markdown-rendering.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9f8aae775afac02d6c97d20a56a4684a3977c08a
--- /dev/null
+++ b/packages/frontend/editor-ui/src/app/__tests__/markdown-rendering.test.ts
@@ -0,0 +1,21 @@
+import { render } from '@testing-library/vue';
+import { performance } from 'node:perf_hooks';
+import VueMarkdown from 'vue-markdown-render';
+
+describe('Markdown wrapper rendering', () => {
+	it('renders mixed quote text with typography enabled', () => {
+		const source = '"a '.repeat(64_000) + "b' ".repeat(64_000);
+		const start = performance.now();
+		const result = render(VueMarkdown, { props: { source, options: { typographer: true } } });
+		expect(result.container.textContent?.length).toBeGreaterThan(300_000);
+		expect(performance.now() - start).toBeLessThan(5_000);
+	}, 15_000);
+
+	it('keeps raw script text and unsupported link protocols out of the document', () => {
+		const source = '<script>fixture</script> [fixture](javascript:fixture)';
+		const result = render(VueMarkdown, { props: { source } });
+		expect(result.container.querySelector('script')).toBeNull();
+		expect(result.container.querySelector('a[href^="javascript:"]')).toBeNull();
+		expect(result.container.textContent).toContain('<script>fixture</script>');
+	});
+});
